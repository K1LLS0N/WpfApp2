<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Margin="10" Grid.Column="0" Grid.ColumnSpan="2" Text="Formularz" HorizontalAlignment="Center" FontSize="32"/>

        <TextBlock Grid.Row="1" Margin="10" Grid.Column="0" Text="Imię i nazwisko" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="TBImieNazwisko" Grid.Row="1" Grid.Column="1" Margin="10" Width="200" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="2" Margin="10" Grid.Column="0" Text="Wiek" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="TBWiek" Grid.Row="2" Grid.Column="1" Margin="10" Width="200" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="3" Margin="10" Grid.Column="0" Text="Płeć" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
            <RadioButton x:Name="RBKobieta" Content="Kobieta" Margin="0,0,15,0" GroupName="Plec"/>
            <RadioButton x:Name="RBMężczyzna" Content="Mężczyzna" GroupName="Plec"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="10" Grid.Column="0" Text="Data urodzenia" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <DatePicker x:Name="DPUrodzenie" Grid.Row="4" Grid.Column="1" Margin="10" Width="200" HorizontalAlignment="Left"/>

        <Button x:Name="Zapisz" Grid.Row="5" Grid.Column="0" Margin="10" Width="100" Height="30" Content="Zapisz" Background="Green" Foreground="White" Click="Zapisz_Click"/>
        <Button x:Name="Anuluj" Grid.Row="5" Grid.Column="1" Margin="10" Width="100" Height="30" Content="Anuluj" HorizontalAlignment="Left" Background="Red" Foreground="White"/>
    </Grid>
</Window>